#!/bin/bash
set -o pipefail

/usr/bin/geckodriver "$@" 2>&1 | while IFS= read -r line; do
  echo "$line"

  case "$line" in
    *"Marionette      INFO    Stopped listening on port"*)
      echo "[firefox-cleanup] killing firefox tree"

      # сначала мягко
      pkill -TERM -f '^/usr/lib/firefox/firefox' || true

      # и сразу жёстко fallback
      pkill -KILL -f '^/usr/lib/firefox/firefox' || true
      ;;
  esac
done

exit ${PIPESTATUS[0]}