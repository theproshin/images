#!/bin/bash

PORT_ARG="$1"
shift

/usr/bin/geckodriver "$PORT_ARG" "$@" 2>&1 | while IFS= read -r line; do
  echo "$line"

  if [[ "$line" == *"Marionette      INFO    Stopped listening on port"* ]]; then
    echo "[firefox-cleanup] marionette stopped, killing firefox"

    pkill -TERM -f '/usr/lib/firefox/firefox --marionette' 2>/dev/null || true
    pkill -TERM -P $(pgrep -f '/usr/lib/firefox/firefox --marionette') 2>/dev/null || true
  fi
done