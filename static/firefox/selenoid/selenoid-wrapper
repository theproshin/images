#!/bin/bash
set -o pipefail

/usr/bin/selenoid "$@" 2>&1 | while IFS= read -r line; do
  echo "$line"

  case "$line" in
    *"[SESSION_DELETED]"*)
      (
        echo "[geckodriver-cleanup] killing hanging firefox"

        pkill -TERM -f 'firefox -contentproc' 2>/dev/null || true
      ) &
      ;;
  esac
done

exit ${PIPESTATUS[0]}