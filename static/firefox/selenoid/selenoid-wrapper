#!/bin/bash
set -o pipefail

/usr/bin/selenoid "$@" 2>&1 | while IFS= read -r line; do
  echo "$line"

  case "$line" in
    *"[SESSION_DELETED]"*)
      (
        echo "[geckodriver-cleanup] killing hanging geckodriver"

        pkill -TERM -f '^/usr/bin/geckodriver --port=' 2>/dev/null || true
        pkill -KILL -f '^/usr/bin/geckodriver --port=' 2>/dev/null || true
      ) &
      ;;
  esac
done

exit ${PIPESTATUS[0]}