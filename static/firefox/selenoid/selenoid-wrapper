#!/bin/bash
set -o pipefail

/usr/bin/selenoid "$@" 2>&1 | while IFS= read -r line; do
  echo "$line"

  case "$line" in
    *"Marionette      INFO    Stopped listening on port"*)
      echo "[firefox-cleanup] marionette stopped, killing firefox"

      pkill -TERM -f '^/usr/lib/firefox/firefox' 2>/dev/null || true
      pkill -KILL -f '^/usr/lib/firefox/firefox' 2>/dev/null || true
      ;;
  esac
done

exit ${PIPESTATUS[0]}