#!/bin/bash
set -o pipefail

/usr/bin/selenoid "$@" 2>&1 | while IFS= read -r line; do
  echo "$line"

  case "$line" in
    *"[SESSION_DELETED]"*)
      (
        echo "[geckodriver-cleanup] killing hanging firefox"

        FIREFOX_PID=$(pgrep -f 'firefox --marionette' | head -n1)

        if [ -n "$FIREFOX_PID" ]; then
          echo "[firefox-cleanup] sending SIGTERM to firefox parent $FIREFOX_PID" >&2
          kill -TERM "$FIREFOX_PID" 2>/dev/null || true
        fi
      ) &
      ;;
  esac
done

exit ${PIPESTATUS[0]}