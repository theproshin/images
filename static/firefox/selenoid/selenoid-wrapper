#!/bin/bash
set -o pipefail

export MOZ_CRASHREPORTER_SHUTDOWN=0
/usr/bin/selenoid "$@" 2>&1 | while IFS= read -r line; do
  echo "$line"

  case "$line" in
    *"[SESSION_DELETED]"*)
      (
        echo "[geckodriver-cleanup] killing hanging firefox"
        pkill -TERM -f 'firefox -contentproc'
      ) &
      ;;
  esac
done

exit ${PIPESTATUS[0]}